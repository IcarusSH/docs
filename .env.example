# Teedy 测试服务器环境变量样板
# 复制本文件为 .env 并填实际值：cp .env.example .env
# .env 已在 .gitignore 忽略，不会被提交

# ---- 服务地址 ----
DOCS_BASE_URL=http://localhost:8080

# ---- 数据库（PostgreSQL）----
DATABASE_URL=jdbc:postgresql://localhost:5432/teedy
DATABASE_USER=teedy
DATABASE_PASSWORD=teedy
DATABASE_POOL_SIZE=10

# ---- 初始 admin 账号（首次启动生效，重启后改这里不会再生效）----
DOCS_ADMIN_EMAIL_INIT=admin@example.com
# DOCS_ADMIN_PASSWORD_INIT 是 bcrypt 哈希，$ 必须 escape 成 $$
# 生成命令：
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'admin123', bcrypt.gensalt(5)).decode())"
# 然后把每个 $ 替换成 $$（bash 不会展开，但 Java Properties 解析需要）
# 例如原哈希：  $2a$05$xxxx...
# 写入这里变成：$$2a$$05$$xxxx...
DOCS_ADMIN_PASSWORD_INIT=$$2a$$05$$placeholder_replace_me

# ---- 可选：SMTP（不填则关闭邮件功能）----
# DOCS_SMTP_HOSTNAME=smtp.example.com
# DOCS_SMTP_PORT=587
# DOCS_SMTP_USERNAME=
# DOCS_SMTP_PASSWORD=

# ---- 可选：默认语言 ----
# DOCS_DEFAULT_LANGUAGE=chi_sim
